DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=your-jwt-secret-here
PORT=5001
# Allowed CORS origins, comma separated (not needed when the backend serves frontend/dist)
FRONTEND_URL=http://localhost:5173
# Enable only on the isolated demo deployment/database.
DEMO_MODE=false
# Project attachments. Set a Cloud Storage bucket in production (Cloud Run has no
# persistent disk); leave empty to store files on local disk under UPLOAD_DIR.
ATTACHMENTS_BUCKET=
UPLOAD_DIR=
