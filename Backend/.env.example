DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=your-jwt-secret-here
PORT=5001
# Allowed CORS origins, comma separated (not needed when the backend serves frontend/dist)
FRONTEND_URL=http://localhost:5173
# Enable only on the isolated demo deployment/database.
DEMO_MODE=false
# Project attachments. Set a Cloud Storage bucket in production (Cloud Run has no
# persistent disk); leave empty to store files on local disk under UPLOAD_DIR.
ATTACHMENTS_BUCKET=
UPLOAD_DIR=
# Email delivery for invitations, login codes and password resets. Leave SMTP_USER and
# SMTP_PASS empty to skip sending (the demo then shows codes and passwords on screen).
# With Gmail, SMTP_PASS is an app password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Proxies in front of the app (1 behind a single load balancer)
TRUST_PROXY_HOPS=1
# Super Admin password used when seeding; required in production
SEED_SUPER_ADMIN_PASSWORD=
