{
  "name": "trackplus",
  "version": "1.0.0",
  "description": "Track Plus — backend API + frontend web app",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon Backend/src/index.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "node Backend/src/index.js",
    "seed": "node Backend/src/utils/seed.js",
    "demo:reset": "node Backend/src/utils/resetDemo.js",
    "demo:check": "node Backend/src/utils/runDemoApiChecks.js",
    "check:attachments": "node Backend/src/utils/runAttachmentChecks.js",
    "check:features": "node Backend/src/utils/runFeatureChecks.js",
    "studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "node Backend/src/utils/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14"
  }
}
